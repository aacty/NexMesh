<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexMesh.AiService</RootNamespace>
    <!-- 模板生成于仓库外,脱离仓库 CPM 作用域:显式版本 + 关闭集中管理 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NexMesh.Host" Version="2.0.0" />
    <PackageReference Include="NexMesh.AI.Approval" Version="2.0.0" />
    <PackageReference Include="NexMesh.Auth" Version="2.0.0" />
    <PackageReference Include="NexMesh.AI.Workflow" Version="2.0.0" />
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
  </ItemGroup>

</Project>
