<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- AI 底座:Microsoft.Extensions.AI + OpenAI 适配 -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="System.ClientModel" Version="1.15.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <!-- Core 基础抽象 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="MiniExcel" Version="1.46.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <!-- 业务层数据栈(demo/业务项目引用,NexMesh.AI 零引用) -->
    <PackageVersion Include="FreeSql" Version="3.5.311" />
    <PackageVersion Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <!-- 测试 -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

</Project>
