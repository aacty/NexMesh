<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>NexMesh v2.0 数据层:多库命名注册 + 软删全局过滤 + 审计自动填充 + 雪花 ID + 乐观并发(→409) + IRepository 仓储 + 数据库版本化迁移(显式链/单迁移单事务/Checksum 防篡改/Redis 分布式锁,生产替代 AutoSyncStructure)</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexMesh.Core\NexMesh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <!-- 迁移分布式锁(Redis 租约,可选功能——不配置即不使用;照 AI.Approval 引 FreeSql 的特性包先例) -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
