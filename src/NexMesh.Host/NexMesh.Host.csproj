<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>NexMesh v2.0 服务宿主总装:一行 AddNexMeshService/UseNexMeshService 装配 配置/约定注入/FreeSql/AI 底座/中间件管道。业务开发者零 DI、零生命周期、零配置代码</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC 面:契约双面输出(JSON-over-gRPC 动态注册) -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexMesh.Core\NexMesh.Core.csproj" />
    <ProjectReference Include="..\NexMesh.AI\NexMesh.AI.csproj" />
    <ProjectReference Include="..\NexMesh.AI.Approval\NexMesh.AI.Approval.csproj" />
    <ProjectReference Include="..\NexMesh.Events\NexMesh.Events.csproj" />
    <ProjectReference Include="..\NexMesh.Data.FreeSql\NexMesh.Data.FreeSql.csproj" />
    <ProjectReference Include="..\NexMesh.Data.Migrations\NexMesh.Data.Migrations.csproj" />
    <ProjectReference Include="..\NexMesh.Cache\NexMesh.Cache.csproj" />
    <ProjectReference Include="..\NexMesh.Auth\NexMesh.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Grpc/contract_gateway.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dashboard 静态页内嵌(Hangfire.AspNetCore 同模式:管理台随宿主包) -->
    <EmbeddedResource Include="Dashboard\wwwroot\index.html" />
  </ItemGroup>
</Project>
